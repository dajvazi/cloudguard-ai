# Copy to .env and fill in your values (never commit .env)

OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Self-healing via SSM Run Command
AWS_EC2_INSTANCE_ID=i-096014610bc8fdd16
AWS__SsmEnabled=true
AWS__AutoHealEnabled=true

# IAM user cloudguard-monitor-user — CloudWatch import:
# cloudwatch:ListMetrics, cloudwatch:GetMetricData, cloudwatch:DescribeAlarms
# (or attach CloudWatchReadOnlyAccess; if "permissions boundary" error, update the boundary too)
#
# IAM user — SSM self-healing:
# ssm:SendCommand, ssm:GetCommandInvocation, ssm:DescribeInstanceInformation
# on instance i-096014610bc8fdd16 and document AWS-RunShellScript
# EC2 instance needs IAM role: AmazonSSMManagedInstanceCore
